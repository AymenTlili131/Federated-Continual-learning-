  pages = {1509--1534},
  issn = {1080-6377},
  doi = {10.1353/ajm.0.0027},
  urldate = {2024-09-20},
  abstract = {This paper proves that every projective toric variety is the fine moduli space for stable representations of an appropriate bound quiver. To accomplish this, we study the quiver \$Q\$ with relations \$R\$ corresponding to the finite-dimensional algebra \$\textbackslash bigl(\textbackslash bigoplus\_\textbraceleft i=0\textbraceright\textasciicircum\textbraceleft r\textbraceright{} L\_i \textbackslash bigr)\$ where \$\textbackslash mathcal\textbraceleft L\textbraceright{} := (\textbackslash mathscr\textbraceleft O\textbraceright\_X,L\_1, ...c, L\_r)\$ is a list of line bundles on a projective toric variety \$X\$. The quiver \$Q\$ defines a smooth projective toric variety, called the multilinear series \$\textbar\textbackslash mathcal\textbraceleft L\textbraceright\textbar\$, and a map \$X \textbackslash to \textbar\textbackslash mathcal\textbraceleft L\textbraceright\textbar\$. We provide necessary and sufficient conditions for the induced map to be a closed embedding. As a consequence, we obtain a new geometric quotient construction of projective toric varieties. Under slightly stronger hypotheses on \$\textbackslash mathcal\textbraceleft L\textbraceright\$, the closed embedding identifies \$X\$ with the fine moduli space of stable representations for the bound quiver \$(Q,R)\$.},
  archiveprefix = {arXiv},
  keywords = {Mathematics - Algebraic Geometry,Mathematics - Representation Theory,Quivers},
