@misc{gabrielssonExpositionInterpretationTopology2019,
  title = {Exposition and {{Interpretation}} of the {{Topology}} of {{Neural Networks}}},
  author = {Gabrielsson, Rickard Br{\"u}el and Carlsson, Gunnar},
  year = 2019,
