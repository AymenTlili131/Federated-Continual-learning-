@misc{hasaniLiquidTimeconstantNetworks2020,
  title = {Liquid {{Time-constant Networks}}},
  author = {Hasani, Ramin and Lechner, Mathias and Amini, Alexander and Rus, Daniela and Grosu, Radu},
