@misc{morrisLearningReason132026,
  title = {Learning to {{Reason}} in 13 {{Parameters}}},
  author = {Morris, John X. and Mireshghallah, Niloofar and Ibrahim, Mark and Mahloujifar, Saeed},
  year = 2026,
